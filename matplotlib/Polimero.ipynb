    "import py3Dmol\n",
    "\n",
    "v = py3Dmol.view(450, 350)\n",
    "v.addModel(\"\"\"8\n",
    "polymer\n",
    "C 0 0 0\n",
    "C 1.5 0 0\n",
    "C 3.0 0 0\n",
    "C 4.5 0 0\n",
    "H 0 -1 0\n",
    "H 1.5 1 0\n",
    "H 3 -1 0\n",
    "H 4.5 1 0\n",
    "\"\"\", \"xyz\")\n",
    "\n",
    "v.setStyle({'stick': {}, 'sphere': {'scale': 0.3}})\n",
    "v.zoomTo()\n",
    "v.spin(True)\n",
    "v.show()"
